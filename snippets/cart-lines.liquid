{% doc %}
  Cart line items with quantity controls and removal. Shared by the cart drawer and
  the cart page. Without JavaScript, the quantity fields submit with the cart form
  (`updates[]`) and remove links use the native /cart/change URL.

  @param {string} context - 'drawer' or 'page' (used for unique ids)

  @example
  {% render 'cart-lines', context: 'drawer' %}
{% enddoc %}
<ul class="cart-lines" role="list">
  {%- for item in cart.items -%}
    {%- assign image = item.image -%}
    <li class="cart-line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
        {%- if image -%}
          {{ image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', width: 100, height: 100 }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </a>
      <div class="cart-line__info">
        <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-line__meta">
            {%- for option in item.options_with_values -%}
              {{ option.name | escape }}: {{ option.value | escape }}{% unless forloop.last %} · {% endunless %}
            {%- endfor -%}
          </p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-line__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
        {%- endif -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-line__meta cart-line__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-line__controls">
          <div class="qty" data-qty>
            <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">
              {% render 'icon', name: 'minus' %}
            </button>
            <label class="visually-hidden" for="Qty-{{ context }}-{{ forloop.index }}">{{ 'cart.quantity_for' | t: title: item.product.title | escape }}</label>
            <input class="qty__input" type="number" inputmode="numeric"
              id="Qty-{{ context }}-{{ forloop.index }}"
              name="updates[]" value="{{ item.quantity }}" min="0"
              {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
              data-line-qty="{{ forloop.index }}">
            <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">
              {% render 'icon', name: 'plus' %}
            </button>
          </div>
          <a href="{{ item.url_to_remove }}" class="cart-line__remove" data-line-remove="{{ forloop.index }}">
            {% render 'icon', name: 'trash' %}
            <span class="visually-hidden">{{ 'cart.remove_title' | t: title: item.product.title | escape }}</span>
            <span aria-hidden="true">{{ 'cart.remove' | t }}</span>
          </a>
        </div>
      </div>
      <div class="cart-line__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
        {%- if item.quantity > 1 -%}
          {%- assign each_price = item.final_price | money -%}
          <span class="cart-line__each">{{ 'cart.each' | t: price: each_price }}</span>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
