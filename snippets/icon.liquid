{% doc %}
  Inline SVG icon set (1.5px line icons, inherits currentColor).

  @param {string} name - Icon name: search, bag, account, menu, close, plus, minus, arrow, chevron, check, truck, return, lock, chat, info, trash, filter, leaf, ruler, instagram, facebook, tiktok, pinterest
  @param {string} [class] - Extra CSS class

  @example
  {% render 'icon', name: 'search' %}
{% enddoc %}
<svg class="icon icon--{{ name }} {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1.2-3.5 3.8-5 7-5s5.8 1.5 7 5"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'close' -%}
      <path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3zM14 9.5h3.5L21 13v2.5h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/>
    {%- when 'return' -%}
      <path d="M9 7 5 11l4 4"/><path d="M5 11h9a5 5 0 0 1 0 10h-2"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3"/>
    {%- when 'chat' -%}
      <path d="M5 5.5h14v10H10l-4 3.5v-3.5H5z"/>
    {%- when 'info' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/>
    {%- when 'trash' -%}
      <path d="M5 7h14M10 7V5h4v2M7 7l1 12h8l1-12"/>
    {%- when 'filter' -%}
      <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
    {%- when 'leaf' -%}
      <path d="M6 18c0-8 5-12 13-12 0 8-4 13-12 13"/><path d="M6 18 13 11"/>
    {%- when 'ruler' -%}
      <path d="m4 15 11-11 5 5L9 20z"/><path d="m8 11 2 2M11 8l2 2M14 5l2 2"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><path d="M16.8 7.2h.01"/>
    {%- when 'facebook' -%}
      <path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5Z"/>
    {%- when 'tiktok' -%}
      <path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.4 2.6 2 4.2 4.5 4.5"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M11 9.5 9 20M10.5 12.5c3.5 1 5.5-1 5.5-3.5 0-2-1.8-3.5-4-3.5-2.6 0-4.5 1.8-4.5 4 0 1 .4 1.8 1 2.2"/>
  {%- endcase -%}
</svg>
