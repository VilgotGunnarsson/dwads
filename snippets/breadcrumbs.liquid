{% doc %}
  Visible breadcrumbs plus matching BreadcrumbList structured data.

  @param {product} [product] - Current product
  @param {collection} [collection] - Current collection

  @example
  {% render 'breadcrumbs', product: product, collection: collection %}
{% enddoc %}
{%- liquid
  assign home_url = request.origin | append: routes.root_url
  assign show_collection = false
  if collection and collection.handle != blank
    assign show_collection = true
  endif
-%}
<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
  <ol role="list">
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {%- if show_collection -%}
      <li>
        {%- if product -%}
          <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
        {%- else -%}
          <span aria-current="page">{{ collection.title | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
    {%- if product -%}
      <li><span aria-current="page">{{ product.title | escape }}</span></li>
    {%- endif -%}
  </ol>
</nav>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ home_url | json }} }
      {%- if show_collection -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
      {%- endif -%}
      {%- if product -%}
        {%- if show_collection %}{% assign pos = 3 %}{% else %}{% assign pos = 2 %}{% endif -%}
        ,{ "@type": "ListItem", "position": {{ pos }}, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
      {%- endif %}
    ]
  }
</script>
