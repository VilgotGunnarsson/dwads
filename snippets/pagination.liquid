{% doc %}
  Accessible pagination for paginated lists.

  @param {object} paginate - The paginate object

  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
    <ul role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" class="pagination__link pagination__link--prev">
            {{- 'general.previous' | t -}}
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__link">
              <span class="visually-hidden">{{ 'general.page_short' | t }}</span> {{ part.title -}}
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__link is-current" aria-current="page">
              <span class="visually-hidden">{{ 'general.page_short' | t }}</span> {{ part.title -}}
            </span>
          {%- else -%}
            <span class="pagination__link">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" class="pagination__link pagination__link--next">
            {{- 'general.next' | t -}}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
