{%- comment -%}
  FAQ accordion using native <details>. Answers must reflect the store's real terms.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container faq">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span>{{ block.settings.question | escape }}</span>
            {% render 'icon', name: 'plus', class: 'accordion__icon accordion__icon--plus' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vanliga frågor",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Frågor och svar" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vanliga frågor" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Hittar du inte svaret? Kontakta oss så hjälper vi dig.</p>"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Färgschema",
      "options": [
        { "value": "base", "label": "Kräm" },
        { "value": "surface", "label": "Benvit" },
        { "value": "beige", "label": "Beige" },
        { "value": "sage", "label": "Salvia" }
      ],
      "default": "base"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Fråga",
      "settings": [
        { "type": "text", "id": "question", "label": "Fråga", "default": "Fråga" },
        { "type": "richtext", "id": "answer", "label": "Svar", "default": "<p>Svar</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vanliga frågor",
      "blocks": [
        { "type": "question", "settings": { "question": "När skickas min beställning?", "answer": "<p>Leveranstiden beror på produkt och leverantör. När en uppskattning finns visas den på produktsidan, och tillgängliga fraktalternativ visas i kassan innan du betalar.</p>" } },
        { "type": "question", "settings": { "question": "Vad kostar frakten?", "answer": "<p>Fraktkostnaden räknas ut i kassan utifrån din beställning och leveransadress, innan du bekräftar köpet.</p>" } },
        { "type": "question", "settings": { "question": "Kan jag ångra mitt köp?", "answer": "<p>Som konsument har du normalt 14 dagars ångerrätt vid köp på distans. Hur du går till väga står i vår returpolicy.</p>" } }
      ]
    }
  ]
}
{% endschema %}
