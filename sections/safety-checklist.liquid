{%- comment -%}
  Interactive safety checklist. Ticks are stored only in the visitor's own browser
  (localStorage) – nothing is sent to the store. Works as a plain list without JS.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container checklist" data-checklist="{{ section.id }}">
    <div class="checklist__head">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
      <p class="checklist__progress" aria-live="polite" data-checklist-progress hidden></p>
      <div class="button-row">
        <button type="button" class="button button--secondary button--small" data-print>{{ 'guide.print' | t }}</button>
        <button type="button" class="link-button" data-checklist-reset hidden>{{ 'guide.reset' | t }}</button>
      </div>
    </div>
    <ul class="checklist__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          <li class="checklist__group-title" {{ block.shopify_attributes }}>
            <h3 class="h4">{{ block.settings.title | escape }}</h3>
          </li>
        {%- else -%}
          <li class="checklist__item" {{ block.shopify_attributes }}>
            <label class="checkbox checkbox--large">
              <input type="checkbox" data-checklist-item="{{ block.id }}">
              <span>
                {{ block.settings.text | escape }}
                {%- if block.settings.collection != blank %}
                  <a class="checklist__link" href="{{ block.settings.collection.url }}">{{ 'guide.see_products' | t }}</a>
                {%- endif -%}
              </span>
            </label>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if section.settings.disclaimer != blank -%}
      <div class="checklist__disclaimer rte muted">{{ section.settings.disclaimer }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Checklista",
  "class": "section-checklist",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Checklista" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Gå igenom hemmet" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Bocka av medan du går runt. Dina val sparas bara i din egen webbläsare.</p>"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Ansvarsfriskrivning",
      "default": "<p>Checklistan är allmän vägledning och ersätter inte tillverkarens anvisningar eller din egen bedömning av hemmet. Mer information om barns säkerhet finns hos <a href=\"https://www.1177.se\" target=\"_blank\">1177</a>.</p>"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Färgschema",
      "options": [
        { "value": "base", "label": "Kräm" },
        { "value": "surface", "label": "Benvit" },
        { "value": "beige", "label": "Beige" },
        { "value": "sage", "label": "Salvia" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Grupp",
      "settings": [
        { "type": "text", "id": "title", "label": "Rubrik", "default": "Kök" }
      ]
    },
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Punkt att kontrollera" },
        { "type": "collection", "id": "collection", "label": "Länka till kollektion" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Checklista",
      "blocks": [
        { "type": "group", "settings": { "title": "Kök" } },
        { "type": "item", "settings": { "text": "Rengöringsmedel och diskmedel förvaras högt eller i låst skåp" } },
        { "type": "item", "settings": { "text": "Lådor med knivar och vassa redskap har spärr" } }
      ]
    }
  ]
}
{% endschema %}
