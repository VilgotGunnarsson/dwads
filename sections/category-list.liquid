{%- comment -%}
  Category index. Each block links to a collection. When no collection is chosen yet,
  the block shows its title with a neutral placeholder image and links to all products.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link link--arrow" href="{{ section.settings.link | default: routes.collections_url }}">
          {{- section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <ul class="category-list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign title = block.settings.title | default: c.title
          assign url = c.url | default: routes.all_products_collection_url
          assign image = block.settings.image | default: c.featured_image
          assign image_alt = image.alt | default: title
        -%}
        <li class="category-list__item" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="category-card">
            <span class="category-card__media">
              {%- if image -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    widths: '300, 450, 600, 750, 900',
                    sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 75vw',
                    loading: 'lazy',
                    alt: image_alt
                }}
              {%- else -%}
                <span class="category-card__fallback category-card__fallback--{{ forloop.index | modulo: 3 }}" aria-hidden="true">
                  <svg class="category-card__fallback-mark" viewBox="0 0 32 32" focusable="false">
                    <path d="M6 26V14C6 9.6 9.6 6 14 6h12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M12 26v-8a6 6 0 0 1 6-6h8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".55"/>
                  </svg>
                  <span class="category-card__fallback-title">{{ title | escape }}</span>
                </span>
              {%- endif -%}
            </span>
            <span class="category-card__label">
              <span class="category-card__index" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="category-card__title">{{ title | escape }}</span>
              {% render 'icon', name: 'arrow', class: 'category-card__arrow' %}
            </span>
            {%- if block.settings.text != blank -%}
              <span class="category-card__text muted">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Kategorier",
  "class": "section-categories",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Sortiment" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Handla efter behov" },
    { "type": "text", "id": "link_label", "label": "Länktext", "default": "Alla kategorier" },
    { "type": "url", "id": "link", "label": "Länk" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Färgschema",
      "options": [
        { "value": "base", "label": "Kräm" },
        { "value": "surface", "label": "Benvit" },
        { "value": "beige", "label": "Beige" },
        { "value": "sage", "label": "Salvia" }
      ],
      "default": "base"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategori",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "title", "label": "Rubrik", "info": "Lämna tomt för att använda kollektionens namn." },
        { "type": "text", "id": "text", "label": "Kort beskrivning" },
        { "type": "image_picker", "id": "image", "label": "Bild", "info": "Ersätter kollektionens bild." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorier",
      "blocks": [
        { "type": "category", "settings": { "title": "Lås & spärrar" } },
        { "type": "category", "settings": { "title": "Kant- & hörnskydd" } },
        { "type": "category", "settings": { "title": "Skåp & lådor" } }
      ]
    }
  ]
}
{% endschema %}
