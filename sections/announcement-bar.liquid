{%- comment -%}
  Optional announcement bar. Leave the text empty to hide it. Intended for honest,
  verifiable messages only – not invented promotions or countdowns.
{%- endcomment -%}
{%- if section.settings.text != blank -%}
  <div class="announcement scheme-{{ section.settings.scheme }}">
    <div class="container announcement__inner">
      <p class="announcement__text">
        {{ section.settings.text | escape }}
        {%- if section.settings.link != blank and section.settings.link_text != blank %}
          <a href="{{ section.settings.link }}" class="announcement__link">{{ section.settings.link_text | escape }}</a>
        {%- endif -%}
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Meddelandefält",
  "class": "section-announcement",
  "settings": [
    {
      "type": "paragraph",
      "content": "Använd bara för korrekta och kontrollerbara meddelanden. Lämna texten tom för att dölja fältet."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Frågor om en produkt innan du beställer? Vi hjälper dig gärna."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Länk"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Länktext",
      "default": "Kontakta oss"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Färgschema",
      "options": [
        { "value": "dark", "label": "Mörk" },
        { "value": "sage", "label": "Salvia" },
        { "value": "beige", "label": "Beige" }
      ],
      "default": "dark"
    }
  ]
}
{% endschema %}
