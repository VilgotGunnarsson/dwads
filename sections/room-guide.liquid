{%- comment -%}
  Room-by-room or stage-by-stage guidance. General information only – no guarantees
  and no medical or regulatory claims. Each block can link to a relevant collection.
{%- endcomment -%}
<section class="section scheme-{{ section.settings.scheme }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container guide">
    <div class="guide__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="link link--arrow" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <ol class="guide__list" role="list">
      {%- for block in section.blocks -%}
        <li class="guide__item" {{ block.shopify_attributes }}>
          <span class="guide__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="guide__body">
            <h3 class="h4">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.collection != blank -%}
              <a class="link link--arrow" href="{{ block.settings.collection.url }}">
                {{- block.settings.link_label | default: block.settings.collection.title | escape }} {% render 'icon', name: 'arrow' %}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Guide rum för rum",
  "class": "section-room-guide",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Rum för rum" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Var börjar man?" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>De flesta hem behöver inte allt på en gång. Börja där barnet faktiskt rör sig och komplettera i takt med att det upptäcker mer.</p>"
    },
    { "type": "text", "id": "link_label", "label": "Länktext", "default": "Hela säkerhetsguiden" },
    { "type": "url", "id": "link", "label": "Länk" },
    {
      "type": "select",
      "id": "scheme",
      "label": "Färgschema",
      "options": [
        { "value": "base", "label": "Kräm" },
        { "value": "surface", "label": "Benvit" },
        { "value": "beige", "label": "Beige" },
        { "value": "sage", "label": "Salvia" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Rum eller steg",
      "settings": [
        { "type": "text", "id": "title", "label": "Rubrik", "default": "Kök" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "collection", "id": "collection", "label": "Länka till kollektion" },
        { "type": "text", "id": "link_label", "label": "Länktext" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide rum för rum",
      "blocks": [
        { "type": "step", "settings": { "title": "Kök", "text": "<p>Lås skåp och lådor med rengöringsmedel, vassa föremål och glas. Tänk på ugnsluckan och lådor i barnets höjd.</p>" } },
        { "type": "step", "settings": { "title": "Vardagsrum", "text": "<p>Skydda vassa hörn på soffbord och hyllor och se över eluttag som barnet når från golvet.</p>" } },
        { "type": "step", "settings": { "title": "Dörrar och trappor", "text": "<p>Dörrstopp och klämskydd minskar risken för klämda fingrar. Vid trappor behövs grindar anpassade för just den placeringen.</p>" } }
      ]
    }
  ]
}
{% endschema %}
