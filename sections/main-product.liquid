{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_demo = false
  if product.tags contains 'demo'
    assign is_demo = true
  endif
  assign media_count = product.media.size
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="product-page" data-product-section data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="container">
    {% render 'breadcrumbs', product: product, collection: collection %}

    <div class="product">
      <div class="product__gallery" data-gallery>
        {%- if media_count > 0 -%}
          <ul class="gallery" role="list" data-gallery-list aria-label="{{ 'products.gallery' | t }}">
            {%- for media in product.media -%}
              <li class="gallery__item{% if media.id == current_variant.featured_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}" id="Media-{{ section.id }}-{{ media.id }}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign priority = 'auto'
                    if forloop.first
                      assign loading = 'eager'
                      assign priority = 'high'
                    endif
                    assign media_alt = media.alt | default: product.title
                  -%}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200, 1600',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      loading: loading,
                      fetchpriority: priority,
                      alt: media_alt
                  }}
                {%- else -%}
                  {{ media | media_tag: image_size: '1200x' }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- if media_count > 1 -%}
            <p class="gallery__counter" aria-hidden="true"><span data-gallery-current>1</span> / {{ media_count }}</p>
          {%- endif -%}
        {%- else -%}
          <div class="gallery__placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>

      <div class="product__info">
        <div class="product__sticky">
          {%- if is_demo -%}
            <span class="badge badge--demo">{{ 'products.demo_badge' | t }}</span>
          {%- endif -%}
          {%- if product.type != blank -%}
            <p class="eyebrow">{{ product.type | escape }}</p>
          {%- endif -%}
          <h1 class="h1 product__title">{{ product.title | escape }}</h1>

          <div class="product__price" data-product-price>
            {% render 'price', product: product, variant: current_variant %}
          </div>
          {%- if cart.taxes_included -%}
            <p class="product__tax muted">{{ 'products.tax_included' | t }}</p>
          {%- endif -%}

          {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- unless product.has_only_default_variant -%}
              <div class="variant-picker" data-variant-picker>
                {%- for option in product.options_with_values -%}
                  {%- comment -%} Single-value options (e.g. "Ships From") stay in the DOM so the picker JS can read them, but are not shown. {%- endcomment -%}
                  <fieldset class="variant-picker__option"{% if option.values.size == 1 %} hidden{% endif %}>
                    <legend class="variant-picker__legend">
                      {{ option.name | escape }}: <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value | escape }}</span>
                    </legend>
                    <div class="variant-picker__values">
                      {%- assign option_index = forloop.index0 -%}
                      {%- for value in option.values -%}
                        <input
                          type="radio"
                          class="visually-hidden variant-picker__input"
                          id="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}"
                          name="option-{{ option_index }}"
                          value="{{ value | escape }}"
                          data-option-index="{{ option_index }}"
                          {% if value.selected %}checked{% endif %}
                        >
                        <label class="variant-picker__label{% unless value.available %} is-unavailable{% endunless %}" for="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index0 }}">
                          {{- value | escape -}}
                          {%- unless value.available %}<span class="visually-hidden"> – {{ 'products.unavailable' | t }}</span>{% endunless -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            {%- if is_demo -%}
              {% render 'demo-notice' %}
            {%- else -%}
              <div class="product-form__row">
                <div class="qty qty--large" data-qty>
                  <button type="button" class="qty__btn" data-qty-minus aria-label="{{ 'products.quantity_decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                  <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                  <input class="qty__input" type="number" id="Quantity-{{ section.id }}" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}"
                    min="{{ current_variant.quantity_rule.min | default: 1 }}"
                    {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
                    step="{{ current_variant.quantity_rule.increment | default: 1 }}" inputmode="numeric">
                  <button type="button" class="qty__btn" data-qty-plus aria-label="{{ 'products.quantity_increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                </div>
                <button type="submit" name="add" class="button button--full" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
                  <span data-add-to-cart-text>
                    {%- if current_variant.available -%}
                      {{ 'products.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>
              </div>
              {%- if section.settings.show_dynamic_checkout -%}
                <div class="product-form__dynamic">{{ form | payment_button }}</div>
              {%- endif -%}
              <p class="form-message form-message--error" role="alert" data-form-error hidden></p>
            {%- endif -%}
          {%- endform -%}

          <p class="product__availability" data-availability>
            <span class="status-dot{% if current_variant.available %} is-available{% endif %}" aria-hidden="true"></span>
            <span data-availability-text>
              {%- if current_variant.available -%}{{ 'products.available' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
            </span>
          </p>

          {% render 'delivery-note', product: product %}

          <div class="product__details">
            {% render 'product-details', product: product %}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'collapsible' -%}
                  <details class="accordion" {{ block.shopify_attributes }}>
                    <summary class="accordion__summary">
                      <span>{{ block.settings.heading | escape }}</span>
                      {% render 'icon', name: 'chevron', class: 'accordion__icon' %}
                    </summary>
                    <div class="accordion__content rte">
                      {{ block.settings.content }}
                      {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                    </div>
                  </details>
                {%- when 'text' -%}
                  <div class="rte product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-variants>
    [
      {%- for variant in product.variants -%}
        {%- capture variant_price -%}{% render 'price', product: product, variant: variant %}{%- endcapture -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "media": {{ variant.featured_media.id | default: 'null' }},
          "priceHtml": {{ variant_price | strip | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{%- unless is_demo -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "Produktinformation",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Visa snabbkassa-knappar",
      "info": "Visar t.ex. Shop Pay eller Apple Pay endast om de är aktiverade i butikens betalinställningar.",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Specifikationer, monteringsanvisning och certifieringar visas först när metafältet custom.specs_verified är satt till ”Sant”. Se docs/SETUP.md."
    }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Fällbar rad",
      "settings": [
        { "type": "text", "id": "heading", "label": "Rubrik", "default": "Rubrik" },
        { "type": "richtext", "id": "content", "label": "Innehåll" },
        { "type": "page", "id": "page", "label": "Innehåll från sida" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ]
}
{% endschema %}
