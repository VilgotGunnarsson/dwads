{%- liquid
  assign heading_tag = 'h2'
  if section.settings.heading_as_h1
    assign heading_tag = 'h1'
  endif
-%}
<section class="section section--{{ section.settings.spacing }} scheme-{{ section.settings.scheme }}">
  <div class="container rich-text rich-text--{{ section.settings.alignment }}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="{% if section.settings.heading_as_h1 %}h1{% else %}h2{% endif %}">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte rich-text__body">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Överrubrik" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Rubrik" },
    { "type": "checkbox", "id": "heading_as_h1", "label": "Rubriken är sidans huvudrubrik (H1)", "default": false },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Skriv en kort text här.</p>" },
    { "type": "text", "id": "button_label", "label": "Knapptext" },
    { "type": "url", "id": "button_link", "label": "Knapplänk" },
    {
      "type": "select",
      "id": "alignment",
      "label": "Justering",
      "options": [
        { "value": "left", "label": "Vänster" },
        { "value": "center", "label": "Centrerad" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Avstånd",
      "options": [
        { "value": "default", "label": "Normalt" },
        { "value": "compact", "label": "Kompakt" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Färgschema",
      "options": [
        { "value": "base", "label": "Kräm" },
        { "value": "surface", "label": "Benvit" },
        { "value": "beige", "label": "Beige" },
        { "value": "sage", "label": "Salvia" },
        { "value": "dark", "label": "Mörk" }
      ],
      "default": "base"
    }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
