{%- comment -%}
  Contact page: native Shopify contact form (messages are emailed to the store's
  sender/contact email set in Settings → Notifications) plus configured company details.
{%- endcomment -%}
<section class="section section--compact">
  <div class="container contact">
    <div class="contact__intro">
      <h1 class="h1 page-title">{{ page.title | default: section.settings.heading | escape }}</h1>
      {%- if page.content != blank -%}
        <div class="rte">{{ page.content }}</div>
      {%- elsif section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {% render 'footer-extras', part: 'company' %}
      {%- if settings.company_hours != blank -%}
        <p class="muted">{{ settings.company_hours | escape }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
          {% render 'icon', name: 'check' %}
          {{ 'contact.success' | t }}
        </p>
      {%- else -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert" id="ContactForm-errors">
            <p>{{ 'contact.error_heading' | t }}</p>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#ContactForm-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }}</a> {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="form-grid">
          <div class="field">
            <label class="field__label" for="ContactForm-name">{{ 'contact.name' | t }}</label>
            <input class="field__input" type="text" id="ContactForm-name" name="contact[{{ 'contact.name' | t }}]" autocomplete="name" value="{{ form.name }}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-email">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
            <input class="field__input" type="email" id="ContactForm-email" name="contact[email]" autocomplete="email" required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactForm-errors"{% endif %}>
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-phone">{{ 'contact.phone' | t }}</label>
            <input class="field__input" type="tel" id="ContactForm-phone" name="contact[{{ 'contact.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-order">{{ 'contact.order_number' | t }}</label>
            <input class="field__input" type="text" id="ContactForm-order" name="contact[{{ 'contact.order_number' | t }}]">
          </div>
          <div class="field field--full">
            <label class="field__label" for="ContactForm-body">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea class="field__input" id="ContactForm-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
        </div>
        <p class="muted contact__privacy">
          {{ 'contact.privacy_note' | t }}
          {%- if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">{{ 'newsletter.privacy_link' | t }}</a>{% endif -%}
        </p>
        <button type="submit" class="button">{{ 'contact.submit' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Kontaktformulär",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Kontakta oss" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text (visas om sidan saknar eget innehåll)",
      "default": "<p>Har du frågor om en produkt, din beställning eller en retur? Skriv till oss så återkommer vi så snart vi kan.</p>"
    }
  ]
}
{% endschema %}
