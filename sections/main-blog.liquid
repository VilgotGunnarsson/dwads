<section class="section section--compact">
  <div class="container">
    <h1 class="h1 page-title">{{ blog.title | escape }}</h1>
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="article-grid" role="list">
          {%- for article in blog.articles -%}
            <li>
              <article class="article-card">
                <a href="{{ article.url }}" class="article-card__media" tabindex="-1" aria-hidden="true">
                  {%- if article.image -%}
                    {{ article.image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <p class="muted article-card__date">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="h4"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              </article>
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="muted">{{ 'blog.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blogg",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
