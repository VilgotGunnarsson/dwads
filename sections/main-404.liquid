<section class="section">
  <div class="container empty-state empty-state--page">
    <p class="eyebrow">404</p>
    <h1 class="h1">{{ 'not_found.title' | t }}</h1>
    <p class="muted">{{ 'not_found.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-form--page">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'search.label' | t }}</label>
      {% render 'icon', name: 'search', class: 'search-form__icon' %}
      <input type="search" id="NotFoundSearch" name="q" class="search-form__input" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="button button--small">{{ 'search.submit' | t }}</button>
    </form>
    <a class="button button--secondary" href="{{ routes.root_url }}">{{ 'not_found.home' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Sidan hittades inte",
  "class": "section-404",
  "settings": []
}
{% endschema %}
