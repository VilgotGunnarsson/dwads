<section class="password">
  <div class="password__inner">
    {% render 'wordmark', size: 'large', link: false %}
    <h1 class="h2">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="muted">{{ shop.password_message }}</p>
    {%- endif -%}
    <div class="password__signup">
      <h2 class="h4">{{ 'password.signup_heading' | t }}</h2>
      {% render 'newsletter-form', id: 'password' %}
    </div>
    <details class="password__login">
      <summary class="link">{{ 'password.enter_with_password' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="field">
          <label class="field__label" for="Password">{{ 'password.password' | t }}</label>
          <input class="field__input" type="password" name="password" id="Password" autocomplete="current-password"
            {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" id="PasswordError" role="alert">{{ 'password.error' | t }}</p>
        {%- endif -%}
        <button type="submit" class="button">{{ 'password.enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Lösenordssida",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Vi öppnar snart" }
  ]
}
{% endschema %}
