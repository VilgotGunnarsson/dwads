  {
    "name": "Produktkort",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Bildformat",
        "options": [
          { "value": "square", "label": "Kvadrat (1:1)" },
          { "value": "portrait", "label": "Stående (4:5)" }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Visa andra bilden vid hovring",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_type",
        "label": "Visa produkttyp",
        "default": true
      }
    ]
  },
  {
    "name": "Varukorg",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Varukorgstyp",
        "options": [
          { "value": "drawer", "label": "Sidopanel" },
          { "value": "page", "label": "Egen sida" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Visa fält för meddelande till butiken",
        "default": false
      }
    ]
  },
  {
    "name": "Leverans, retur och priser",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fyll bara i uppgifter som är bekräftade med din leverantör och dina fraktinställningar. Tomma fält visar ett neutralt meddelande i stället för ett löfte."
      },
      {
        "type": "text",
        "id": "delivery_text",
        "label": "Leveranstid (standard för alla produkter)",
        "info": "T.ex. ”Normalt 5–9 arbetsdagar”. Lämna tomt tills leveranstiden är bekräftad. Kan ersättas per produkt med metafältet custom.delivery_estimate."
      },
      {
        "type": "textarea",
        "id": "returns_text",
        "label": "Kort text om ångerrätt och retur",
        "info": "En länk till returpolicyn läggs till automatiskt när policyn finns under Inställningar → Policyer.",
        "default": "Som konsument har du normalt 14 dagars ångerrätt vid köp på distans."
      },
      {
        "type": "header",
        "content": "Prisvisning"
      },
      {
        "type": "checkbox",
        "id": "show_compare_at_price",
        "label": "Visa jämförpris (rea)",
        "info": "Av som standard. Enligt prisinformationslagen ska ett angivet ordinarie pris vid prissänkning vara det lägsta priset de senaste 30 dagarna. Aktivera bara om dina jämförpriser uppfyller kraven.",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Visa ikoner för aktiverade betalsätt i sidfoten",
        "info": "Visar endast de betalsätt som faktiskt är aktiverade i butiken.",
        "default": true
      }
    ]
  },
  {
    "name": "Företagsuppgifter",
    "settings": [
      {
        "type": "paragraph",
        "content": "Enligt e-handelslagen ska kunder enkelt kunna hitta företagets namn, organisationsnummer, adress och e-post. Uppgifterna visas i sidfoten och på kontaktsidan när de är ifyllda."
      },
      {
        "type": "text",
        "id": "company_name",
        "label": "Företagsnamn"
      },
      {
        "type": "text",
        "id": "company_org_number",
        "label": "Organisationsnummer"
      },
      {
        "type": "textarea",
        "id": "company_address",
        "label": "Postadress"
      },
      {
        "type": "text",
        "id": "company_email",
        "label": "E-post för kundservice"
      },
      {
        "type": "text",
        "id": "company_phone",
        "label": "Telefon (valfritt)"
      },
      {
        "type": "text",
        "id": "company_hours",
