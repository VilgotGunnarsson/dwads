[
  {
    "name": "theme_info",
    "theme_name": "Lugnhem",
    "theme_version": "1.0.0",
    "theme_author": "Lugnhem",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Varumärke",
    "settings": [
      {
        "type": "paragraph",
        "content": "Varumärkesnamnet används i ordmärket, sidtitlar, sidfot och metadata. Byt det här så uppdateras hela temat. Ändra även butikens namn under Inställningar → Allmänt – det visas i kassan och i e-postmeddelanden."
      },
      {
        "type": "text",
        "id": "brand_name",
        "label": "Varumärkesnamn",
        "default": "Lugnhem"
      },
      {
        "type": "text",
        "id": "brand_tagline",
        "label": "Slogan",
        "default": "Barnsäkerhet för ett lugnare hem"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logotyp (valfri)",
        "info": "Lämna tomt för att använda ordmärket. SVG eller PNG med transparent bakgrund rekommenderas."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logotypens bredd",
        "min": 60,
        "max": 240,
        "step": 4,
        "unit": "px",
        "default": 120
      },
      {
        "type": "checkbox",
        "id": "show_brand_mark",
        "label": "Visa symbol bredvid ordmärket",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32 × 32 px"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Standardbild för delning i sociala medier",
        "info": "Används när sidan saknar egen bild. 1200 × 630 px rekommenderas."
      }
    ]
  },
